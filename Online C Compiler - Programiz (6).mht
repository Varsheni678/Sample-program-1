  .maximized .logo-sub-title-wrapper { margin-left: 11px; }
  .maximized #logo { width: 66px; height: 22px; }
  .maximized .sidebar-wrapper { display: none; }
  .maximized .editor-workspace-wrapper { width: 100%; }
  .maximized .header { grid-template-columns: 5fr 1fr 4fr; }
  .maximized #add-replacement { width: 0px; }
}

@media screen and (min-width: 1200px) {
  .spinner { width: calc(100% + 54px); }
}

@media screen and (min-width: 1200px) and (min-height: 720px) {
  .spinner { width: calc(100% - 262px); }
  .desktop-right-ad { display: block; width: 316px; min-height: 608px; float: right; padding: 8px 8px 0px; margin: 0px auto; box-sizing: border-box; border-left: 1px solid rgb(211, 220, 230); border-top: 1px solid rgb(211, 220, 230); }
  .editor-wrapper, .terminal-wrapper { width: calc(50% - 159px); transition: 0.3s; }
  .dark-mode .desktop-right-ad { border-left: 1px solid rgba(255, 255, 255, 0.2); border-top: 1px solid rgba(255, 255, 255, 0.2); }
  .maximized .editor-wrapper, .maximized .terminal-wrapper { width: calc(50% - 1px); }
}

@media screen and (max-width: 799px) {
  .wrapper { --mobile-header-height: 52px; --mobile-top-bar-height: 50px; overflow: hidden auto; overscroll-behavior: contain; }
  .header, .main-content-wrapper, .mobile-ad-wrapper, .mobile-top-bar { flex: 0 0 auto; }
  .header { position: sticky; top: 0px; z-index: 30; }
  .mobile-top-bar { position: sticky; top: var(--mobile-header-height); z-index: 29; height: var(--mobile-top-bar-height); box-sizing: border-box; }
  .mobile-top-bar-run-button img, .mobile-top-bar-run-button svg { display: block; width: 16px; height: 16px; }
  .main-content-wrapper { height: calc(100% - var(--mobile-header-height) - var(--mobile-top-bar-height)); }
}

h1, p { margin: 0px; padding: 0px; }

.not-found { color: rgb(37, 38, 94); }

.header { border-bottom: 1px solid rgb(211, 220, 230); }

.light-mode-logo { display: block; }

.dark-mode-logo { display: none; }

.contain { margin-top: 24px; }

.not-found-container { height: 100vh; margin: 0px auto; padding-right: 24px; padding-left: 24px; }

.error-header { display: flex; flex-direction: column; margin: 60px 0px; }

.error-code { font-size: 64px; line-height: 72px; }

.error-message { font-size: 40px; line-height: 60px; font-weight: 700; }

.error-message, .info { color: rgba(37, 38, 94, 0.7); }

.info { font-size: 18px; line-height: 30px; margin-bottom: 32px; }

.not-found-button {
  font-size: 16px; line-height: 24px; padding: 12px 32px; font-weight: 700; transition: 0.2s ease-in; border-radius: 4px; text-align: center; color: rgb(255, 255, 255); background-color: rgb(5, 86, 243); cursor: pointer; text-decoration: none;
  &:hover { background: rgb(0, 71, 209); }
}

.dark-mode.not-found { color: rgba(255, 255, 255, 0.87); }

.dark-mode .error-message, .dark-mode .info { color: rgba(255, 255, 255, 0.7); }

.dark-mode .light-mode-logo { display: none; }

.dark-mode .dark-mode-logo { display: block; }

@media (min-width: 768px) {
  .contain { margin-top: 40px; }
  .not-found-container { width: 100%; max-width: 720px; padding-right: 16px; padding-left: 16px; align-items: center; }
  .error-header { margin: 120px 0px; }
  .error-code { font-size: 144px; line-height: 147px; }
  .error-message { font-size: 64px; line-height: 72px; }
}

@media (min-width: 992px) {
  .not-found-container { width: 100%; max-width: 960px; }
  .error-header { flex-direction: row; align-items: center; gap: 80px; }
}

@media (min-width: 1140px) {
  .not-found-container { width: 100%; max-width: 1172px; }
}
